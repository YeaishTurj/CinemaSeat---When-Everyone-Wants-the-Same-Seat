# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cinemaseat
DATABASE_URL=postgres://postgres:postgres@postgres:5432/cinemaseat

# API
HOLD_TTL_SECONDS=300
PORT=3000
NODE_ENV=development

# Gateway (mock-gateway image — see gateway reference)
GATEWAY_URL=http://gateway:9000
GATEWAY_SECRET=z2p-2026-secret
GATEWAY_TIMEOUT_MS=6000

# Database connection-pool ceiling
PG_POOL_MAX=30

# Local demo only: exposes the mock gateway's documented OTP debug record.
# Set false in production.
ENABLE_DEV_OTP=true

# Local demo: OTP is always delivered after ~2 seconds with code 123456.
# Leave empty in production to restore the gateway's documented 10% loss rate.
OTP_MOCK_MODE=deterministic

# Local demo: payments succeed deterministically after ~2 seconds.
# Leave empty in production to restore failure, delay, and duplicate chaos.
GATEWAY_MOCK_MODE=deterministic
